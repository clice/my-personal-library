{
  "name": "My Personal Library",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:3": {}
  },
  "postCreateCommand": "test -f .env || cp .env.example .env",
  "postStartCommand": "sudo iptables-legacy -P FORWARD ACCEPT || sudo iptables -P FORWARD ACCEPT || true",
  "forwardPorts": [8001],
  "portsAttributes": {
    "8001": {
      "label": "My Personal Library",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
